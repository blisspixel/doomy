[gd_scene load_steps=2 format=3 uid="uid://c8solo_boot_menu01"]

[ext_resource type="Script" path="res://scripts/boot_menu.gd" id="1_boot"]

[node name="BootMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_boot")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.04, 0.06, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
theme_override_colors/font_color = Color(0.92, 0.88, 0.72, 1)
text = "fragr"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.55, 0.7, 0.72, 1)
text = "CONTESTED FREQUENCY // SOLO SCRAP"
horizontal_alignment = 1

[node name="SoloButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(320, 44)
layout_mode = 2
text = "Solo Scrap (local bots)"

[node name="SpectateButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2
text = "Spectate Local"

[node name="JoinButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(320, 40)
layout_mode = 2
text = "Join Host (MP)"

[node name="HostRow" type="HBoxContainer" parent="Center/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HostLabel" type="Label" parent="Center/VBox/HostRow"]
layout_mode = 2
text = "Host:"

[node name="HostEdit" type="LineEdit" parent="Center/VBox/HostRow"]
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
text = "127.0.0.1:6767"
placeholder_text = "127.0.0.1:6767"

[node name="StatusLabel" type="Label" parent="Center/VBox"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
theme_override_font_sizes/font_size = 12
text = "Offline Solo Scrap uses loopback 6767."
autowrap_mode = 3
horizontal_alignment = 1

[connection signal="pressed" from="Center/VBox/SoloButton" to="." method="_on_solo_pressed"]
[connection signal="pressed" from="Center/VBox/SpectateButton" to="." method="_on_spectate_pressed"]
[connection signal="pressed" from="Center/VBox/JoinButton" to="." method="_on_join_pressed"]
